{
	"extends": "$app/tsconfig",
	"include": ["src", "worker-configuration.d.ts", "*.ts"],
	"compilerOptions": {
		// mirrors the package.json `imports`: TypeScript resolves those without
		// extension substitution, so `#lib/meta` would need the full `.ts`
		"paths": {
			"#lib/*": ["./src/lib/*"]
		},
		// the source is all TypeScript; this keeps the built Worker that
		// `wrangler types` links in via `mainModule` out of the type check
		"checkJs": false,
		"strict": true,
		"sourceMap": true,
		"types": ["$app/types", "node"]
	}
}
